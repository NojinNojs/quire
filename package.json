{
  "name": "quire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun biome check .",
    "format": "bun --bun biome format --write .",
    "test": "bun --bun vitest run src",
    "test:smoke": "python3 -B -m unittest discover -s scripts -p 'test_db_smoke.py' && bun --bun vitest run scripts/evidence-server.test.mjs scripts/cover-cleanup.test.mjs",
    "gate": "bash scripts/gate.sh",
    "ci": "bash scripts/gate.sh",
    "release": "bash scripts/release.sh",
    "test:e2e": "bun --bun playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
